<?xml version="1.0"?>
<mujoco model="drawer">
  <worldbody>
    <body name="drawer_base" pos="0.65 0 0.5" mocap="true">
      <!--
        Cabinet (static shell, 5 walls): outer 40x18x25 cm, wall thickness 1 cm.
        Outer bounds: x[-0.001, 0.249], y[-0.20, 0.20], z[-0.09, 0.09]
        Open front (robot side).
      -->
      <geom type="box" name="body_top"    pos="0.124  0      0.085"  size="0.125 0.200 0.005" condim="3" friction="1 0.03 0.003" rgba="0.5 0.5 0 0.8" contype="2" conaffinity="1" solref="0.01 1"/>
      <geom type="box" name="body_bottom" pos="0.124  0     -0.085"  size="0.125 0.200 0.005" condim="3" friction="1 0.03 0.003" rgba="0.5 0.5 0 0.8" contype="2" conaffinity="1" solref="0.01 1"/>
      <geom type="box" name="body_left"   pos="0.124  0.195  0"      size="0.125 0.005 0.080" condim="3" friction="1 0.03 0.003" rgba="0.5 0.5 0 0.8" contype="2" conaffinity="1" solref="0.01 1"/>
      <geom type="box" name="body_right"  pos="0.124 -0.195  0"      size="0.125 0.005 0.080" condim="3" friction="1 0.03 0.003" rgba="0.5 0.5 0 0.8" contype="2" conaffinity="1" solref="0.01 1"/>
      <geom type="box" name="body_back"   pos="0.244  0      0"      size="0.005 0.200 0.090" condim="3" friction="1 0.03 0.003" rgba="0.5 0.5 0 0.8" contype="2" conaffinity="1" solref="0.01 1"/>

      <!-- Base site positioned at handle location when joint = 0 (closed) -->
      <site name="base_site" pos="-0.04 0.0 0.0" size="0.01" rgba="0 0 1 0.3"/>

      <body name="handle">
        <joint name="drawer_slide" type="slide" axis="1 0 0" range="-0.25 0" limited="true" damping="0.1"/>

        <!-- Front panel (thin, same as before) -->
        <geom type="box" name="drawer_panel" pos="-0.01 0 0" size="0.009 0.20 0.09" condim="3" friction="1 0.03 0.003" rgba="0 1 0 0.2" contype="2" conaffinity="1" solref="0.01 1"/>

        <!--
          Drawer shell (4 walls): outer 38x16x25 cm, wall thickness 8 mm.
          Outer bounds: x[-0.001, 0.249], y[-0.19, 0.19], z[-0.08, 0.08]
          Open top, open front (panel covers front).
        -->
        <geom type="box" name="box_bottom" pos="0.124  0      -0.076"  size="0.125 0.190 0.004" condim="3" friction="1 0.03 0.003" rgba="0 0.8 0 0.5" contype="2" conaffinity="1" solref="0.01 1"/>
        <geom type="box" name="box_left"   pos="0.124  0.186   0.004"  size="0.125 0.004 0.076" condim="3" friction="1 0.03 0.003" rgba="0 0.8 0 0.5" contype="2" conaffinity="1" solref="0.01 1"/>
        <geom type="box" name="box_right"  pos="0.124 -0.186   0.004"  size="0.125 0.004 0.076" condim="3" friction="1 0.03 0.003" rgba="0 0.8 0 0.5" contype="2" conaffinity="1" solref="0.01 1"/>
        <geom type="box" name="box_back"   pos="0.245  0       0"      size="0.004 0.190 0.080" condim="3" friction="1 0.03 0.003" rgba="0 0.8 0 0.5" contype="2" conaffinity="1" solref="0.01 1"/>

        <!-- Handle bar and connectors -->
        <geom type="box" name="handle"          pos="-0.044  0.0   0.0" size="0.004 0.05  0.004" condim="3" friction="1 0.03 0.003" rgba="0 1 0 1" contype="2" conaffinity="1" solref="0.01 1"/>
        <geom type="box" name="connector_left"  pos="-0.0295  0.05 0.0" size="0.0105 0.004 0.004" condim="3" friction="1 0.03 0.003" rgba="0 1 0 1" contype="2" conaffinity="1" solref="0.01 1"/>
        <geom type="box" name="connector_right" pos="-0.0295 -0.05 0.0" size="0.0105 0.004 0.004" condim="3" friction="1 0.03 0.003" rgba="0 1 0 1" contype="2" conaffinity="1" solref="0.01 1"/>

        <!-- Object site for observations (manipulation point) -->
        <site name="object_site" pos="-0.044 0.0 0" size="0.01 0.01 0.01" rgba="1 0 0 1"/>
      </body>
    </body>
  </worldbody>
</mujoco>
