<?xml version="1.0"?>
<mujoco model="cylinder">
  <worldbody>
    <body name="cylinder" pos="0.4 0 0.3">
      <freejoint name="cylinder_joint"/>
      <geom type="cylinder" name="cylinder_geom" size="0.02 0.02" mass="0.05" rgba="0.2 0.8 0.2 1.0" condim="3" friction="1 0.03 0.003" contype="1" conaffinity="1" solref="0.01 1"/>
      <!-- Object site for observations (manipulation point) -->
      <site name="object_site" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>
    </body>
  </worldbody>
</mujoco>
